# Stage 1: grab my gmsh runner (!) image, but use it as builder for now
FROM ghcr.io/malteschoen/gmsh:latest AS builder

# Install build dependencies - will need cleanup in the future
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    cmake \
    libgmp-dev \
    build-essential \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Go to folder where repo will be downloaded to
# permissible as there is a genuine install step below
WORKDIR /repoDownload

# Clone ftetwild repository - comment out if already cloned
# ToDo: make conditional (don't clone if already existing)
RUN git clone https://github.com/wildmeshing/fTetWild

# Create build directory and run cmake & make
# make sure to comment out the 'mkdir build' if it already exists
# ToDo: make mkdir conditional (don't clone if already existing)

WORKDIR /repoDownload/fTetWild

# Inject CMP0169 policy globally
RUN printf "cmake_policy(SET CMP0169 OLD)\n" > /repoDownload/fTetWild/policy_override.cmake

RUN mkdir build 
WORKDIR /repoDownload/fTetWild/build
RUN cmake .. -DCMAKE_PROJECT_INCLUDE=/repoDownload/fTetWild/policy_override.cmake -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc) 

# Stage 2: grab my gmsh runner (!) image and use it as a runner this time
FROM ghcr.io/malteschoen/gmsh:latest AS runner

# Copy compiled binary from builder
COPY --from=builder /repoDownload/fTetWild/build/FloatTetwild_bin  /usr/local/bin/FloatTetwild_bin 

# check if ftetwild has the libraries it needs
RUN ldd /usr/local/bin/FloatTetwild_bin