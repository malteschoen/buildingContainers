# Stage 1: grab builder image
FROM ubuntu:noble AS builder

# Install build dependencies - will need cleanup in the future
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
	ca-certificates \
	cmake \
    zlib1g-dev \
	libpng-dev \
    libcairo2-dev \
	libfreetype6-dev\
	libjson-c-dev \
    libfontconfig1-dev \
	libpangomm-1.4-dev \
	libgl-dev \
    libglu-dev \
	libspnav-dev\
	libgtkmm-3.0-dev\
    libocct-modeling-algorithms-dev\
	libocct-data-exchange-dev\
	libtbb-dev\
    && rm -rf /var/lib/apt/lists/*

# Go to folder where repo will be downloaded to
WORKDIR /repoDownload

# Clone neosolve repository 
RUN git clone https://github.com/0xSeren/neosolve

# submodules
WORKDIR /repoDownload/neosolve
RUN git submodule update --init

#build
RUN mkdir build
WORKDIR /repoDownload/neosolve/build
RUN  cmake .. -DCMAKE_BUILD_TYPE=Release -DENABLE_OPENMP=ON  &&  make -j$(nproc)


# output
RUN cp -vfr /repoDownload/neosolve/build /shared/build


# to install on NOBLE host system i
# sudo apt install 
