# Stage 1: grab builder image
FROM docker.io/termux/termux-docker
USER system 
SHELL ["sh", "-c"]
WORKDIR /data/data/com.termux/files/home
ENTRYPOINT ["/entrypoint.sh"]
CMD ["login"]

# install what i need
RUN pkg install -y git build-essential libxft

# Go to folder where repo will be downloaded to
WORKDIR /repoDownload

# Clone occt repository 
RUN git clone https://github.com/Open-Cascade-SAS/OCCT

# submodules
WORKDIR /repoDownload/OCCT

#build
RUN mkdir build
WORKDIR /repoDownload/OCCT/build
RUN cmake .. &&  make -j$(nproc)

